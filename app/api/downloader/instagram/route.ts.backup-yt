import { NextResponse } from "next/server";

function cleanInstagramUrl(rawUrl: string): string {
  let parsed: URL;

  try {
    parsed = new URL(rawUrl.trim());
  } catch {
    throw new Error("Format link Instagram tidak valid.");
  }

  if (!["instagram.com", "www.instagram.com", "instagr.am", "www.instagr.am"].includes(parsed.hostname.toLowerCase())) {
    throw new Error("Domain Instagram tidak valid.");
  }

  if (!["http:", "https:"].includes(parsed.protocol)) {
    throw new Error("Protokol link tidak valid.");
  }

  const match = parsed.pathname.match(/^\/(reel|reels|p|tv)\/([A-Za-z0-9_-]+)/i);

  if (!match) {
    throw new Error("Link Reel, Post, atau IGTV tidak dikenali.");
  }

  const type = match[1].toLowerCase() === "reels" ? "reel" : match[1].toLowerCase();

  return `https://www.instagram.com/${type}/${match[2]}/`;
}

type MediaItem = {
  type: "video" | "image";
  hdUrl: string;
  sdUrl: string;
  thumbnail?: string;
};

function validMediaUrl(value: unknown): value is string {
  if (typeof value !== "string") return false;

  try {
    const url = new URL(value);
    return url.protocol === "https:" &&
      !["localhost", "127.0.0.1", "::1"].includes(url.hostname);
  } catch {
    return false;
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function normalizeItems(items: unknown): MediaItem[] {
  if (!Array.isArray(items)) return [];

  return items.flatMap((item: unknown) => {
    const url = typeof item === "string"
      ? item
      : isRecord(item) ? item.url : undefined;

    if (!validMediaUrl(url)) return [];

    const sd = isRecord(item) ? item.sd : undefined;
    const thumbnail = isRecord(item) ? item.thumbnail : undefined;
    return [{
      type: /\.mp4(?:$|[?#])/i.test(url) ? "video" as const : "image" as const,
      hdUrl: url,
      sdUrl: validMediaUrl(sd) ? sd : url,
      ...(validMediaUrl(thumbnail) ? { thumbnail } : {}),
    }];
  });
}

async function fetchJson(url: string): Promise<Record<string, unknown>> {
  const response = await fetch(url, {
    headers: {
      "User-Agent": "Mozilla/5.0",
      "Accept": "application/json",
    },
    signal: AbortSignal.timeout(6500),
    cache: "no-store",
  });

  if (!response.ok) throw new Error("Provider HTTP error");

  const data: unknown = await response.json();

  if (!isRecord(data)) {
    throw new Error("Respons provider tidak valid");
  }

  return data;
}

export async function GET(request: Request) {
  const { searchParams } = new URL(request.url);
  const rawUrl = searchParams.get("url");

  if (!rawUrl) {
    return NextResponse.json(
      { error: "Link Instagram tidak boleh kosong." },
      { status: 400 }
    );
  }

  let cleanUrl: string;

  try {
    cleanUrl = cleanInstagramUrl(rawUrl);
  } catch {
    return NextResponse.json(
      { error: "Link Instagram tidak valid. Gunakan link Reel, Post, atau IGTV publik." },
      { status: 400 }
    );
  }

  const encoded = encodeURIComponent(cleanUrl);

  const engines = [
    async () => normalizeItems((await fetchJson(
      `https://api.nstar.yuhu.biz.id/api/downloader/igdl?url=${encoded}`
    ))?.data),

    async () => normalizeItems((await fetchJson(
      `https://api.alyachan.dev/api/ig?url=${encoded}`
    ))?.data),

    async () => normalizeItems((await fetchJson(
      `https://api.ryzendesu.vip/api/downloader/ig?url=${encoded}`
    ))?.url),

    async () => normalizeItems((await fetchJson(
      `https://api.siputzx.my.id/api/d/ig?url=${encoded}`
    ))?.data),

    async () => normalizeItems((await fetchJson(
      `https://api.vreden.web.id/api/igdownload?url=${encoded}`
    ))?.result),
  ];

  try {
    const attempts = engines.map(async (runEngine, index) => {
      try {
        const media = await runEngine();

        if (media.length === 0) {
          throw new Error("Respons tidak berisi media valid");
        }

        console.log(`[Instagram] Provider ${index + 1} berhasil: ${media.length} media`);
        return media;
      } catch (error) {
        console.error(
          `[Instagram] Provider ${index + 1} gagal:`,
          error instanceof Error ? error.message : String(error)
        );
        throw error;
      }
    });

    const media = await Promise.any(attempts);

    return NextResponse.json({
      success: true,
      media,
      cleanUrl,
    });
  } catch {
    return NextResponse.json(
      {
        error: "Gagal memproses media. Pastikan postingan bersifat publik dan coba lagi nanti.",
      },
      { status: 502 }
    );
  }
}
